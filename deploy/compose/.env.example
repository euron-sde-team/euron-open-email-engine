# Generated by `make env` (scripts/gen-local-env.sh) with random values. Local only.
EMAIL_JWT_SECRET=replace-with-output-of-make-env
# Encrypts the secrets the API stores at rest. Changing it makes the stored ones
# unreadable (re-enter them in the app).
# Sign the public unsubscribe, confirmation, web-view and tracking links (32+ characters
# each). Changing one invalidates every link already sent.
EMAIL_UNSUBSCRIBE_SIGNING_SECRET=replace-with-output-of-make-env
EMAIL_TRACKING_SIGNING_SECRET=replace-with-output-of-make-env
# Every demo account (make demo) signs in with this password (passed to the seed as
# DEMO_PASSWORD).
EMAIL_DEMO_PASSWORD=replace-with-output-of-make-env

# Sending. simulated (the compose default) needs no AWS: the mailer emits SES-shaped
# events itself and bounce@, soft@ and complaint@ addresses misbehave on purpose. The
# Floci overlay (make up) switches to aws against the emulator; make up-aws uses real SES.
# EMAIL_SES_MODE=simulated
# Host the tracking CNAMEs (track.<tenant domain>) point to. Locally the API; on AWS the
# load balancer or CloudFront host (terraform output tracking_cname_target).
# EMAIL_TRACKING_HOST=localhost
# Sends per second for one tenant, and for the whole SES account (your SES max send rate).
# EMAIL_DEFAULT_TENANT_TPS=5
# EMAIL_ACCOUNT_TPS=14
# Reputation gates, as fractions (0.05 = 5 percent): a tenant is throttled at WARN and its
# marketing mail paused at PAUSE. SES reviews an account from 5 percent bounces and 0.1
# percent complaints, so keep PAUSE below that.
# EMAIL_REPUTATION_BOUNCE_WARN=0.03
# EMAIL_REPUTATION_BOUNCE_PAUSE=0.05
# EMAIL_REPUTATION_COMPLAINT_WARN=0.0005
# EMAIL_REPUTATION_COMPLAINT_PAUSE=0.001
# Simulated mode: a domain verifies after this many minutes without any DNS.
# EMAIL_DOMAIN_SIMULATE_VERIFY_MINUTES=2

# Every key in this file reaches the API container (env_file).

# Files (CSV imports, uploaded images): local disk by default. With the Floci overlay,
# the emulated bucket:
# AWS_S3_BUCKET=open-email-local-files

# Optional overrides (host ports and names)
# EMAIL_BRAND_NAME=Open Email Engine
# LOG_LEVEL=info
# EMAIL_WEB_PORT=3650
# EMAIL_CONSOLE_PORT=3660
# EMAIL_API_PORT=5126
# EMAIL_PG_PORT=5572
# EMAIL_REDIS_PORT=6509
# EMAIL_FLOCI_PORT=4677
# EMAIL_MAILPIT_PORT=8126
