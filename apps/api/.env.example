# Euron Open Email Engine API. Copy to .env for running the API outside Docker.
# With no AWS keys the engine runs in simulated mode: domains verify without DNS, sends are
# recorded and simulated (no mail leaves), delivery events are generated locally.
# Full reference: docs/guides/configuration.md

# ---- Server ----
NODE_ENV=development
PORT=5126
# Reverse proxies in front of the API (ALB = 1, CloudFront + ALB = 2).
TRUST_PROXY=1
# Browser origins allowed to call the API. Defaults to EMAIL_APP_URL,OPERATOR_APP_URL.
CORS_ORIGINS=

# ---- Secrets (production refuses to start on the defaults) ----
# Random, 32+ characters each. `make env` generates them for Docker.
JWT_SECRET=
JWT_EXPIRY=12h
# Sign the links inside emails. Unsubscribe, view and confirmation links use the first; the
# open pixel and click redirect use the second. Both default to JWT_SECRET.
EMAIL_UNSUBSCRIBE_SIGNING_SECRET=
EMAIL_TRACKING_SIGNING_SECRET=

# ---- PostgreSQL ----
# The API reads the PG_DATABASE_* variables. The migration runner (pnpm db:migrate)
# reads DATABASE_URL when it is set, else the same PG_DATABASE_* variables.
DATABASE_URL=postgres://mail:mail@localhost:5572/mail
PG_DATABASE_HOST=localhost
PG_DATABASE_PORT=5572
PG_DATABASE_USER=mail
PG_DATABASE_PASSWORD=mail
PG_DATABASE=mail
PG_POOL_MAX=10
PG_POOL_MIN=0

# ---- Redis (queues, caches, rate limits). Blank = in-process fallback ----
REDIS_URL=redis://localhost:6509/0

# ---- Public URLs (bare origins, no trailing slash) ----
# The workspace app: sign-in, invite and reset links.
EMAIL_APP_URL=http://localhost:3650
# The operator console: operator password-reset links.
OPERATOR_APP_URL=http://localhost:3660
# The API itself, which serves /t /u /w /f /c at its root: tracked links, unsubscribe pages,
# subscribe forms. Must be the public https origin in production.
APP_PUBLIC_URL=http://localhost:5126
# Display name in platform emails.
BRAND_NAME=Open Email Engine

# ---- Sending ----
# aws | simulated. Blank = simulated when no SES sender is configured, else aws.
# Always simulated under tests. Production refuses simulated.
EMAIL_SES_MODE=
# Simulated domains verify on their own after this many minutes (0 = only on "Check now").
EMAIL_DOMAIN_SIMULATE_VERIFY_MINUTES=2
# CNAME target shown for every track.<domain> record.
EMAIL_TRACKING_HOST=track.mail-engine.example
# Serve links from a tenant's verified track.<domain> over https (needs certificates for
# those names). Off by default: links use APP_PUBLIC_URL.
EMAIL_TRACKING_CUSTOM_DOMAINS=false
# Per-tenant and account-wide send rates (messages per second).
EMAIL_DEFAULT_TENANT_TPS=5
EMAIL_ACCOUNT_TPS=14
# Recipients claimed per batch while a campaign sends.
EMAIL_SEND_BATCH=50
# Reputation tiers over a rolling 14 days (fractions). THROTTLED sits halfway between.
EMAIL_REPUTATION_MIN_SENDS=100
EMAIL_REPUTATION_BOUNCE_WARN=0.03
EMAIL_REPUTATION_BOUNCE_PAUSE=0.05
EMAIL_REPUTATION_COMPLAINT_WARN=0.0005
EMAIL_REPUTATION_COMPLAINT_PAUSE=0.001

# ---- AWS (S3 files, SES email, SQS events). Blank bucket = local disk ----
AWS_REGION=us-east-1
AWS_S3_BUCKET=
# Optional static keys; otherwise the default AWS credential chain (task role).
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=
# Point every AWS client at an emulator (Floci) during local development. DNS lookups for
# domain verification are skipped against an emulator; the SES status is trusted instead.
AWS_ENDPOINT_URL=
# Platform sender for invites and password resets. Blank = those are simulated too.
AWS_SES_REGION=
AWS_SES_ACCESS_KEY=
AWS_SES_SECRET_KEY=
AWS_SES_FROM_EMAIL=
AWS_SES_FROM_NAME=Open Email Engine
# Delivery events (created by the Terraform email module) and their dead-letter queue.
SES_EVENTS_SNS_TOPIC_ARN=
SES_EVENTS_QUEUE_URL=
SES_EVENTS_DLQ_URL=

# ---- Local file storage (used when AWS_S3_BUCKET is blank) ----
LOCAL_STORAGE_DIR=

# ---- Demo seed (pnpm demo:seed; refuses production) ----
EMAIL_DEMO_PASSWORD=
