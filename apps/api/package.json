{
  "name": "@open-email/api",
  "version": "0.1.0",
  "private": true,
  "description": "Euron Open Email Engine API: tenant plane, operator plane, sending pipeline, tracking and the background worker",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "rimraf dist && tsc",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit && tsc -p tsconfig.contract.json",
    "test": "vitest run tests/unit",
    "test:integration": "vitest run tests/api tests/operator",
    "gen:types": "prisma generate",
    "demo:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-ses": "^3.1068.0",
    "@aws-sdk/client-sesv2": "^3.1069.0",
    "@aws-sdk/client-sns": "^3.1069.0",
    "@aws-sdk/client-sqs": "^3.1069.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.79.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.28.8",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "ulid": "^2.3.0",
    "winston": "^3.18.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.39.1",
    "prisma": "^6.16.0",
    "prisma-kysely": "^2.3.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^4.1.12"
  }
}
