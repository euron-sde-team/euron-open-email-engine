# Copy to terraform.tfvars (git-ignored) and replace every placeholder.
region      = "us-east-1"
name_prefix = "mail-prod" # 3-24 lowercase letters, digits, hyphens

domain          = "mail.example.com"         # the tenant app; its /api/* is the API
console_domain  = "console.mail.example.com" # the operator console
route53_zone_id = "<ROUTE53_HOSTED_ZONE_ID>" # automatic certificates + DNS
# Without a Route53 zone, bring both certificates instead and publish the DNS records
# from the outputs (cdn_dns_records, mail_dns_records):
# certificate_arn     = "<regional ACM certificate for both hosts>"
# cdn_certificate_arn = "<us-east-1 ACM certificate for both hosts>"

# mail_domain    = "example.com"           # platform sending domain, defaults to domain
# tracking_host  = "mail.example.com"      # where tenants' track.<domain> CNAMEs point, defaults to domain

# image_tag is passed by `make aws-deploy` (the git commit); set it here to pin a release.
# image_tag = "0.1.0"

# alarm_email = "oncall@example.com"

# Graviton tasks (cheaper). Build the images to match: PLATFORM=linux/arm64 make aws-deploy
# cpu_architecture = "ARM64"

# JWT_SECRET and the two link-signing secrets are generated
# into <name_prefix>/app.

# SES. aws sends through SES (the account starts in its sandbox: request production
# access before tenants send). The TPS values should match your SES maximum send rate.
# email_ses_mode           = "aws"
# email_default_tenant_tps = 5
# email_account_tps        = 14
